# TechPulse Environment Configuration
# Default zero-setup uses SQLite. To use PostgreSQL via Docker, set DATABASE_URL=postgresql://techpulse:techpulse@localhost:5432/techpulse and provider = "postgresql" in schema.prisma
DATABASE_URL="file:./dev.db"
APP_URL=http://localhost:3000
BACKEND_PORT=4000
AI_URL=http://localhost:8000
TOKEN_ENC_KEY=e8f9a2c3d4e5f60718293a4b5c6d7e8f0123456789abcdef0123456789abcdef

# Optional: GitHub OAuth App (Create at https://github.com/settings/developers)
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Optional: Google Gemini API Key (Get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: NewsAPI Key (Get free key at https://newsapi.org)
NEWS_API_KEY=your_news_api_key_here

# Optional: Stack Exchange Key (https://api.stackexchange.com)
STACK_KEY=your_stack_exchange_key_here
